{
  "expo": {
    "name": "WeFlix",
    "slug": "weflix",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.weflix.app"
    },
    "android": {
      "package": "com.weflix.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "WeFlix needs access to your photo library to set your profile picture."
        }
      ]
    ]
  }
}
